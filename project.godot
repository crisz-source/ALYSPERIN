config_version=5

[application]

config/name="ALYSPERIN"
run/main_scene="res://game/world/areas/prototype_area/prototype_area.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Hitstop="*res://game/systems/hitstop.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

